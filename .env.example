# Create an API key at https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" for that Google Cloud project.
# Add the key here. Do not prefix it with NEXT_PUBLIC_.
YOUTUBE_API_KEY=

# Contact form email (Gmail: use an App Password, not your normal password)
SMTP_USER=unwoke1.0@gmail.com
SMTP_PASS=your-16-character-app-password
# Optional: where inquiries go (defaults to the email in lib/config.ts)
# CONTACT_TO_EMAIL=unwoke1.0@gmail.com

# Audience stats (optional - YouTube uses YOUTUBE_API_KEY, TikTok needs nothing)
# X_BEARER_TOKEN=
# FACEBOOK_PAGE_ID=
# FACEBOOK_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=
